{
  "name": "compences",
  "version": "0.1.0",
  "private": true,
  "description": "Compences \u2014 community & residential society management platform (web, mobile, WhatsApp, AI).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:status": "bash scripts/migrations-pending.sh",
    "db:seed": "tsx scripts/seed.ts",
    "db:test": "bash scripts/db-test.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "society:create": "tsx scripts/create-society.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "~19.2.2"
    }
  }
}
