# ---------------------------------------------------------------------------
# Compences — environment
# Copy to `.env.local` (web) and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Project Settings → API. The anon key is public and safe in a browser bundle.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Bypasses row-level security completely. Server-side only — required for the
# WhatsApp webhook and for API-key requests. Never expose it to a client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public origin of the deployment. Used to build OAuth redirect URLs, so it
# must match exactly what you registered with Google and Supabase.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- WhatsApp (Meta Cloud API) ---------------------------------------------
# All four are required for the bot to run; leaving any unset disables it
# rather than accepting webhooks it cannot verify.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# App secret — used to verify the X-Hub-Signature-256 header on every webhook.
WHATSAPP_APP_SECRET=""
# Any random string; you enter the same value in the Meta webhook setup screen.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_VERSION="v21.0"
# Shown to residents on the settings page so they know who to message.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Push notifications ----------------------------------------------------
# Shared with the database: pg_net sends it as x-dispatch-secret when it calls
# /api/webhooks/push-dispatch. Put the same value, with that URL, in
#   insert into app.push_dispatch_config (url, secret) values ('https://<host>/api/webhooks/push-dispatch', '<secret>');
# Unset, the endpoint answers 503 and notifications stay in-app only.
NOTIFICATIONS_DISPATCH_SECRET=""
# Optional. Needed only if "enhanced push security" is on for the EAS project.
EXPO_ACCESS_TOKEN=""

# --- Expo / mobile ---------------------------------------------------------
# Same two Supabase values, under the prefix Expo inlines.
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Where the mobile app finds the REST API.
EXPO_PUBLIC_API_URL="http://localhost:3000"
